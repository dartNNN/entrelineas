{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entrelineas.local/format/manifest.schema.json",
  "title": "Manifest",
  "description": "Book package manifest (manifest.json in a .bbook.zip). The package is a ZIP with manifest.json and one JSON document per chapter (chapter.schema.json). Readers accept any 1.x schema and ignore fields they do not know.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "author",
    "studied",
    "support",
    "maxOccurrence",
    "chapters"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Format version; 1.4 adds the chapter dictionary and the origin of lexical comments."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "studied": {
      "type": "string",
      "description": "Language of the original, ISO 639-1 (es)."
    },
    "support": {
      "type": "string",
      "description": "Language of the hints, ISO 639-1 (ru)."
    },
    "maxOccurrence": {
      "type": "integer",
      "minimum": 1,
      "description": "Lexical comments are present up to this occurrence of each sense; readers fade them earlier by the owner's threshold."
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "title",
          "file"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^chapters/[0-9]{3}\\.json$"
          }
        }
      }
    }
  }
}
