{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entrelineas.local/format/chapter.schema.json",
  "title": "Chapter",
  "description": "Chapter document (chapters/NNN.json in a .bbook.zip). Token ranges are inclusive indices into the sentence's tokens. The original text is the tokens with their trailing whitespace (ws); every annotation is a separate layer over it.",
  "type": "object",
  "required": [
    "index",
    "title",
    "paragraphs"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "references": {
      "description": "The published translation, one entry per aligned group of sentences (1.1); a sentence points to its group by ref.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "null where the translator left the sentences out."
          },
          "loose": {
            "type": "boolean",
            "description": "A free rendering."
          },
          "uncertain": {
            "type": "boolean",
            "description": "The text may not render these sentences."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids of the translator's footnotes in it."
          }
        }
      }
    },
    "footnotes": {
      "description": "Footnotes (1.2): the translator's (reference) and the author's (source).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "side"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "side": {
            "enum": [
              "reference",
              "source"
            ]
          }
        }
      }
    },
    "entries": {
      "description": "Dictionary entries of the chapter's words (1.4), keyed like lexical comments without the sense (lemma|POS), for the word card. A book built without a model has them since 1.4, a book built with one since 1.5.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sentences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]{2}p[0-9]{3}$"
          },
          "heading": {
            "type": "boolean",
            "description": "The chapter title as an annotated paragraph (1.3)."
          },
          "sentences": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sentence"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "integer",
      "minimum": 0
    },
    "sentence": {
      "type": "object",
      "required": [
        "id",
        "tokens",
        "ws",
        "segments",
        "grammar",
        "context",
        "variants",
        "expressions",
        "lexical"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c[0-9]{2}p[0-9]{3}s[0-9]+$"
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "ws": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Whitespace after each token; same length as tokens."
        },
        "segments": {
          "description": "Sense groups with their literal translation and an optional literary one: [first, last, literal, literary|null].",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "prefixItems": [
              {
                "$ref": "#/$defs/range"
              },
              {
                "$ref": "#/$defs/range"
              },
              {
                "type": "string"
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              }
            ]
          }
        },
        "grammar": {
          "description": "[first, last, topic key, note].",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "prefixItems": [
              {
                "$ref": "#/$defs/range"
              },
              {
                "$ref": "#/$defs/range"
              },
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "context": {
          "description": "[first, last, note].",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "prefixItems": [
              {
                "$ref": "#/$defs/range"
              },
              {
                "$ref": "#/$defs/range"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "variants": {
          "description": "[first, last, [options], note].",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "prefixItems": [
              {
                "$ref": "#/$defs/range"
              },
              {
                "$ref": "#/$defs/range"
              },
              {
                "type": [
                  "array",
                  "string"
                ]
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              }
            ]
          }
        },
        "expressions": {
          "description": "[first, last, expression, meaning].",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "prefixItems": [
              {
                "$ref": "#/$defs/range"
              },
              {
                "$ref": "#/$defs/range"
              },
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "lexical": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lexical"
          }
        },
        "ref": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Index into references."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids of the author's footnotes in this sentence."
        }
      }
    },
    "lexical": {
      "description": "A word comment: the sense used here and its occurrence number in the book.",
      "type": "object",
      "required": [
        "t",
        "lemma",
        "key",
        "n",
        "gloss"
      ],
      "properties": {
        "t": {
          "$ref": "#/$defs/range",
          "description": "Token index."
        },
        "lemma": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "pattern": "^[^|]+\\|[A-Z]+#.+$",
          "description": "lemma|POS#sense: what familiar marks and fading count."
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "description": "Occurrence of this sense in the book."
        },
        "gloss": {
          "type": "string"
        },
        "gram": {
          "type": [
            "string",
            "null"
          ]
        },
        "form": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "enum": [
            "model",
            "dictionary"
          ],
          "description": "Who chose the sense (1.4): the language model, or the dictionary without a model (then it may not fit the context)."
        },
        "sense": {
          "type": "string",
          "description": "Id of the chosen sense in the chapter's dictionary entry (1.5), when the key's sense id is the model's own numbering; otherwise the part of the key after '#'."
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "headword",
        "senses"
      ],
      "properties": {
        "headword": {
          "type": "string"
        },
        "senses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "gram": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
